# Runtime connection (use a pooled PostgreSQL URL in serverless production).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/reventaiq?schema=public"

# Direct connection used only by Prisma CLI migrations when a pooler is present.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/reventaiq?schema=public"

# Public application origin. No trailing slash.
APP_URL="http://localhost:3000"

# Reserved for the future single-admin authentication milestone.
# Generate at least 32 random bytes; never commit the real value.
AUTH_SECRET="replace-with-a-random-secret"
